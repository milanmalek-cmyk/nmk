#!/usr/bin/env bash
# Zažene lokalno dev okolje za multimedija.net (Docker: PHP/Apache + MariaDB + WP-CLI).
# Če v www/ še ni WordPressa, namesti svežo kopijo. Če stran že obstaja (naložena kopija
# produkcije), samo poskrbi, da se povezuje na lokalno bazo.
#
# Uporaba:  ./start-multimedija
# Od koderkoli:  sudo ln -sf "$(pwd)/start-multimedija" /usr/local/bin/start-multimedija
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

command -v docker >/dev/null 2>&1 || { echo "Docker ni nameščen ali ni v PATH."; exit 1; }
docker compose version >/dev/null 2>&1 || { echo "Manjka 'docker compose' (Compose v2)."; exit 1; }

if [ ! -f .env ]; then
  cp .env.example .env
  echo "Ustvaril sem .env iz .env.example (po potrebi uredi vrata / PHP verzijo)."
fi
set -a; . ./.env; set +a

# www-data v kontejnerju dobi UID/GID tvojega uporabnika -> brez težav z dovoljenji v www/
export WWW_UID="${WWW_UID:-$(id -u)}"
export WWW_GID="${WWW_GID:-$(id -g)}"
if [ "$WWW_UID" = "0" ]; then export WWW_UID=33 WWW_GID=33; fi

url="${SITE_URL:-http://localhost:${WEB_PORT:-8080}}"
mkdir -p www

echo "Zaganjam kontejnerje ..."
docker compose up -d --build

wp() { docker compose exec -T -u www-data -e HOME=/tmp web wp "$@"; }

if [ ! -f www/wp-config.php ]; then
  echo
  echo "WordPress še ni nameščen – nameščam svežo kopijo (${WP_LOCALE:-sl_SI}) ..."
  if [ ! -f www/wp-load.php ]; then
    wp core download --locale="${WP_LOCALE:-sl_SI}" --version="${WP_VERSION:-latest}"
  fi
  wp config create \
    --dbname="${DB_NAME:-multimedija}" --dbuser="${DB_USER:-wp}" --dbpass="${DB_PASSWORD:-wp}" \
    --dbhost=db --dbprefix="${DB_PREFIX:-wp_}" --extra-php <<'PHP'
define( 'WP_DEBUG', true );
define( 'WP_DEBUG_LOG', true );
define( 'WP_DEBUG_DISPLAY', false );
define( 'WP_ENVIRONMENT_TYPE', 'development' );
define( 'FS_METHOD', 'direct' );
PHP
  wp core install --url="$url" --title="${WP_TITLE:-Multimedija (dev)}" \
    --admin_user="${WP_ADMIN_USER:-admin}" --admin_password="${WP_ADMIN_PASSWORD:-admin}" \
    --admin_email="${WP_ADMIN_EMAIL:-admin@multimedija.local}" --skip-email
  wp option update timezone_string 'Europe/Ljubljana' >/dev/null
  wp rewrite structure '/%postname%/' --hard >/dev/null
  fresh=1
else
  # naložena stran naj uporablja lokalno bazo (host "db" in podatki iz .env)
  wp config set DB_HOST db --type=constant --quiet 2>/dev/null || echo "Opozorilo: DB_HOST v wp-config.php nisem mogel nastaviti – preveri ročno (mora biti 'db')."
  wp config set DB_NAME "${DB_NAME:-multimedija}" --type=constant --quiet 2>/dev/null || true
  wp config set DB_USER "${DB_USER:-wp}" --type=constant --quiet 2>/dev/null || true
  wp config set DB_PASSWORD "${DB_PASSWORD:-wp}" --type=constant --quiet 2>/dev/null || true
  # trdo kodiran produkcijski URL bi preusmerjal na produkcijo
  for c in WP_HOME WP_SITEURL; do
    if wp config has "$c" --quiet 2>/dev/null; then
      wp config set "$c" "$url" --type=constant --quiet 2>/dev/null || true
    fi
  done
  fresh=0
fi

echo
echo "================= MULTIMEDIJA DEV ================="
echo "Stran:     $url"
echo "Admin:     $url/wp-admin"
if [ "$fresh" = 1 ]; then
  echo "Prijava:   ${WP_ADMIN_USER:-admin} / ${WP_ADMIN_PASSWORD:-admin}   (sveža namestitev)"
else
  if siteurl=$(wp option get siteurl 2>/dev/null); then
    if [ "$siteurl" != "$url" ]; then
      echo
      echo "OPOZORILO: siteurl v bazi je '$siteurl', lokalno pa '$url'."
      echo "Zamenjaj URL-je:  ./scripts/wp.sh search-replace '$siteurl' '$url' --all-tables --skip-columns=guid"
      echo "(ali uvozi bazo z ./scripts/import-db.sh, ki to naredi samodejno)"
    fi
  else
    echo "Baza je še prazna ali nedosegljiva – uvozi jo:  ./scripts/import-db.sh pot/do/baza.sql"
  fi
fi
echo "Adminer:   docker compose --profile tools up -d adminer   ->  http://localhost:${ADMINER_PORT:-8081}"
echo "WP-CLI:    ./scripts/wp.sh <ukaz>        Logi:  docker compose logs -f web"
echo "Ustavi:    ./stop-multimedija"
echo "==================================================="

# odpri brskalnik (če je na voljo)
if [ "${NO_BROWSER:-0}" != "1" ]; then
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 || true
  elif command -v wslview >/dev/null 2>&1; then wslview "$url" >/dev/null 2>&1 || true
  fi
fi

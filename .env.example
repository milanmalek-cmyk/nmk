# ---- Vrata na gostitelju (localhost) ----
WEB_PORT=8080
ADMINER_PORT=8081
DB_PORT=3307
# Na katerem naslovu poslušajo vrata (127.0.0.1 = samo ta računalnik; 0.0.0.0 = tudi iz omrežja)
WEB_BIND=127.0.0.1

# ---- PHP verzija spletnega kontejnerja (8.1 / 8.2 / 8.3) ----
# Če stari vtičniki na 8.2 ne delajo, nastavi 8.1 in ponovno zaženi ./start-multimedija
PHP_VERSION=8.2

# ---- Baza (host je znotraj Dockerja vedno "db") ----
DB_NAME=multimedija
DB_USER=wp
DB_PASSWORD=wp
DB_ROOT_PASSWORD=root
DB_PREFIX=wp_

# ---- Sveža WordPress namestitev (uporabi se samo, če www/ še nima wp-config.php) ----
WP_LOCALE=sl_SI
WP_VERSION=latest
WP_TITLE="Multimedija (dev)"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@multimedija.local

# ---- Produkcijski URL (za zamenjavo URL-jev pri uvozu baze) ----
PROD_URL=https://multimedija.net

# ---- Neobvezno: lastna lokalna domena (privzeto http://localhost:WEB_PORT) ----
# SITE_URL=http://multimedija.local:8080

# ---- Neobvezno: UID/GID za dovoljenja v www/ (privzeto se vzame `id -u` / `id -g`) ----
# WWW_UID=1000
# WWW_GID=1000

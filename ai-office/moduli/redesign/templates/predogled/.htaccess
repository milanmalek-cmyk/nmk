# Predlog prenove – zaščiten predogled (Multimedija AI REDESIGN)
# Dostop samo z geslom, brez indeksiranja v iskalnikih.

AuthType Basic
AuthName "{REALM}"
AuthUserFile {HTPASSWD}
Require valid-user

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

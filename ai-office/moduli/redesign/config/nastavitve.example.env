# Kopiraj v nastavitve.env (ni v gitu) in izpolni.
# Gesla strežnika NE vpisuj sem – PREVIEW_PASSWORD nastavi v okolju ali kot GitHub Secret.
# Komentarji samo v svojih vrsticah (ne za vrednostjo).

AGENCIJA="Multimedija"

# Domena za predloge prenov (vsak predogled dobi podmapo <stranka>-<naključni niz>)
PREVIEW_BASE_URL=https://predlogi.multimedija.net
# sftp | ftp | ftps
PREVIEW_PROTOCOL=sftp
PREVIEW_HOST=
PREVIEW_PORT=
PREVIEW_USER=
# Koren domene predogledov na strežniku
PREVIEW_REMOTE_DIR=/public_html/predlogi
# Mapa za .htpasswd – po možnosti zunaj spletnega korena
PREVIEW_HTPASSWD_DIR=/home/UPORABNIK/.htpasswds/predlogi

# Pošiljatelj za prodajne osnutke (e-pošta se nikoli ne pošlje samodejno)
POSILJATELJ_IME=
POSILJATELJ_FUNKCIJA=
POSILJATELJ_TELEFON=
POSILJATELJ_EPOSTA=
# vikanje | tikanje
NAGOVOR=vikanje

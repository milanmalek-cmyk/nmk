# lokalne nastavitve
.env

# WordPress stran v www/ – ne sledimo (jedro, vtičniki, uploads).
# Struktura je večplastna, da lahko kasneje dodamo izjemo za lastno (child) temo.
www/*
!www/.gitkeep
!www/wp-content/
www/wp-content/*
!www/wp-content/themes/
www/wp-content/themes/*
# primer (odkomentiraj, ko obstaja):
# !www/wp-content/themes/multimedija-child/

# posnetki teme brez odvisnosti
snapshot/**/node_modules/
snapshot/**/vendor/

# arhivi, izvozi baze, Duplicator paketi
*.daf
*.zip
*.sql
*.sql.gz
*.tar.gz
installer.php
*_installer.php

# OS / urejevalniki
.DS_Store
Thumbs.db
.idea/
.vscode/

# AI Office – modul AI REDESIGN
ai-office/**/node_modules/
ai-office/**/__pycache__/
ai-office/**/.cache/
ai-office/**/.posnetki/
ai-office/moduli/redesign/config/nastavitve.env
ai-office/projekti/**/06_predogled/izdaja/
ai-office/projekti/**/06_predogled/.dostop
ai-office/projekti/**/06_predogled/.htpasswd
# paketi za ChatGPT se shranjujejo (stalna povezava za prenos)
!ai-office/projekti/**/*-chatgpt.zip
